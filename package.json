{
  "name": "fallout-lore-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lore:validate": "tsx scripts/lore.ts validate",
    "lore:build": "tsx scripts/lore.ts build",
    "lore:quality": "tsx scripts/lore.ts quality",
    "lore:reference:sync": "tsx scripts/reference.ts sync",
    "lore:reference:sync:offline": "tsx scripts/reference.ts sync --offline",
    "lore:reference:validate": "tsx scripts/reference.ts validate",
    "lore:coverage": "tsx scripts/reference.ts coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lore:validate && pnpm lore:quality && pnpm lore:reference:validate && pnpm lore:build && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.19.0"
}
