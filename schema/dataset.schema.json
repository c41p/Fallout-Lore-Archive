{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fallout-lore-archive.local/schema/dataset-v0.1.json",
  "title": "Fallout Lore Archive canonical dataset",
  "type": "object",
  "required": ["schemaVersion", "entities", "names", "predicates", "assertions", "sourceWorks", "sourceItems", "evidenceLinks", "spatialRepresentations", "appearances", "disputes"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "predicates": { "type": "array", "items": { "$ref": "#/$defs/predicate" } },
    "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "sourceWorks": { "type": "array", "items": { "$ref": "#/$defs/sourceWork" } },
    "sourceItems": { "type": "array", "items": { "$ref": "#/$defs/sourceItem" } },
    "evidenceLinks": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "spatialRepresentations": { "type": "array", "items": { "$ref": "#/$defs/spatial" } },
    "appearances": { "type": "array", "items": { "$ref": "#/$defs/appearance" } },
    "disputes": { "type": "array", "items": { "$ref": "#/$defs/dispute" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9_.-]+$" },
    "entityType": { "enum": ["individual", "organisation", "place", "event", "technology", "substance_condition", "artefact", "concept"] },
    "partialDate": { "type": "object", "required": ["year"], "properties": { "year": { "type": "integer", "minimum": 0, "maximum": 9999 }, "month": { "type": "integer", "minimum": 1, "maximum": 12 }, "day": { "type": "integer", "minimum": 1, "maximum": 31 } }, "additionalProperties": false },
    "temporal": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["point", "interval", "relative", "unknown"] }, "start": { "$ref": "#/$defs/partialDate" }, "end": { "$ref": "#/$defs/partialDate" }, "precision": { "enum": ["day", "month", "year", "approximate", "unknown"] }, "approximate": { "type": "boolean" }, "display": { "type": "string" }, "relativeConstraints": { "type": "array", "items": { "type": "object", "required": ["relation", "entityId"], "properties": { "relation": { "enum": ["before", "after"] }, "entityId": { "$ref": "#/$defs/id" } }, "additionalProperties": false } } }, "additionalProperties": false },
    "articleSection": { "type": "object", "required": ["id", "title", "paragraphs", "assertionIds"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" }, "title": { "type": "string", "minLength": 1 }, "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "assertionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "relatedEntityIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }, "additionalProperties": false },
    "entity": { "type": "object", "required": ["id", "type", "subtype", "displayName", "summary", "tags", "recordStatus"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "$ref": "#/$defs/entityType" }, "subtype": { "type": "string" }, "displayName": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "articleTier": { "enum": ["major", "supporting"] }, "articleSections": { "type": "array", "items": { "$ref": "#/$defs/articleSection" } }, "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "recordStatus": { "enum": ["reviewed", "candidate"] }, "featured": { "type": "boolean" } }, "additionalProperties": false },
    "name": { "type": "object", "required": ["id", "entityId", "name", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "entityId": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "kind": { "type": "string" }, "preferred": { "type": "boolean" } }, "additionalProperties": false },
      "predicate": { "type": "object", "required": ["id", "label", "subjectTypes", "objectTypes", "presentationGroup"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "inverseId": { "type": "string" }, "inverseLabel": { "type": "string" }, "subjectTypes": { "type": "array", "items": { "$ref": "#/$defs/entityType" } }, "objectTypes": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/entityType" }, { "enum": ["temporal", "text"] }] } }, "symmetric": { "type": "boolean" }, "temporalAllowed": { "type": "boolean" }, "presentationGroup": { "type": "string" } }, "additionalProperties": false },
    "assertion": { "type": "object", "required": ["id", "subjectId", "predicateId", "object", "assertionMode", "epistemicStatus", "continuityScope"], "properties": { "id": { "$ref": "#/$defs/id" }, "subjectId": { "$ref": "#/$defs/id" }, "predicateId": { "$ref": "#/$defs/id" }, "object": { "type": "object", "minProperties": 1, "maxProperties": 1, "properties": { "entityId": { "$ref": "#/$defs/id" }, "temporal": { "$ref": "#/$defs/temporal" }, "text": { "type": "string" } }, "additionalProperties": false }, "assertionMode": { "enum": ["world_claim", "source_statement", "editorial_inference", "editorial_hypothesis"] }, "epistemicStatus": { "enum": ["explicit", "strongly_supported", "inferred", "approximate", "uncertain", "disputed", "contradicted", "unknown"] }, "validTime": { "$ref": "#/$defs/temporal" }, "continuityScope": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string" } }, "additionalProperties": false },
    "sourceWork": { "type": "object", "required": ["id", "title", "workType", "materialStatus", "continuityClassification"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "workType": { "type": "string" }, "releaseDate": { "type": "string" }, "materialStatus": { "type": "string" }, "continuityClassification": { "type": "string" } }, "additionalProperties": false },
      "sourceItem": { "type": "object", "required": ["id", "workId", "sourceType", "title", "locator", "sourceClass", "textAvailability"], "properties": { "id": { "$ref": "#/$defs/id" }, "workId": { "$ref": "#/$defs/id" }, "sourceType": { "type": "string" }, "title": { "type": "string" }, "locator": { "type": "string" }, "sourceClass": { "type": "string" }, "textAvailability": { "type": "string" }, "url": { "type": "string" }, "date": { "type": "string" }, "context": { "type": "string" } }, "additionalProperties": false },
    "evidence": { "type": "object", "required": ["id", "targetId", "sourceItemId", "role", "directness"], "properties": { "id": { "$ref": "#/$defs/id" }, "targetId": { "$ref": "#/$defs/id" }, "sourceItemId": { "$ref": "#/$defs/id" }, "role": { "type": "string" }, "directness": { "type": "string" }, "note": { "type": "string" } }, "additionalProperties": false },
    "spatial": { "type": "object", "required": ["id", "placeId", "geometryKind", "latitude", "longitude", "precision", "confidence", "basis"], "properties": { "id": { "$ref": "#/$defs/id" }, "placeId": { "$ref": "#/$defs/id" }, "geometryKind": { "enum": ["exact_point", "approximate_point"] }, "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 }, "precision": { "type": "string" }, "confidence": { "type": "string" }, "basis": { "type": "string" }, "notes": { "type": "string" } }, "additionalProperties": false },
    "appearance": { "type": "object", "required": ["id", "entityId", "workId", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "entityId": { "$ref": "#/$defs/id" }, "workId": { "$ref": "#/$defs/id" }, "kind": { "type": "string" } }, "additionalProperties": false },
    "dispute": { "type": "object", "required": ["id", "assertionIds", "topicEntityIds", "issueType", "editorialStatus", "assessment"], "properties": { "id": { "$ref": "#/$defs/id" }, "assertionIds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } }, "topicEntityIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "issueType": { "type": "string" }, "editorialStatus": { "type": "string" }, "assessment": { "type": "string" } }, "additionalProperties": false }
  }
}
