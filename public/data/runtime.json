ave","type":"organisation","subtype":"faction","displayName":"Enclave","summary":"A secretive organisation descended from elements of the pre-War United States government.","tags":["enclave","united-states","oil-rig"],"recordStatus":"reviewed"},{"id":"ent.vault_tec","type":"organisation","subtype":"company","displayName":"Vault-Tec Corporation","summary":"The pre-War corporation responsible for the Vault programme.","tags":["vaults","pre-war"],"recordStatus":"reviewed"},{"id":"ent.ncr","type":"organisation","subtype":"government","displayName":"New California Republic","summary":"A post-War republic founded from Shady Sands and expanded across parts of California and into the Mojave.","tags":["ncr","shady-sands","hoover-dam"],"recordStatus":"reviewed","featured":true},{"id":"ent.caesars_legion","type":"organisation","subtype":"faction","displayName":"Caesar's Legion","summary":"An expansionist autocracy formed from conquered tribes and led by Caesar.","tags":["legion","mojave","hoover-dam"],"recordStatus":"reviewed"},{"id":"ent.mojave_brotherhood","type":"organisation","subtype":"chapter","displayName":"Mojave Brotherhood of Steel","summary":"A Brotherhood chapter based in the Mojave Wasteland, centred on Hidden Valley.","tags":["brotherhood","mojave","hidden-valley"],"recordStatus":"reviewed"},{"id":"ent.followers","type":"organisation","subtype":"faction","displayName":"Followers of the Apocalypse","summary":"A humanitarian organisation devoted to education, medicine and preserving knowledge.","tags":["followers","boneyard","mojave"],"recordStatus":"reviewed"},{"id":"ent.great_khans","type":"organisation","subtype":"tribe","displayName":"Great Khans","summary":"A tribal society descended from earlier Khan groups and active in the Mojave region.","tags":["khans","mojave"],"recordStatus":"reviewed"},{"id":"ent.unity","type":"organisation","subtype":"faction","displayName":"Unity","summary":"The Master's movement to transform wasteland populations through the Forced 