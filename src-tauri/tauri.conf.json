{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fallout Lore Archive",
  "version": "0.1.0",
  "identifier": "org.falloutlore.archive",
  "build": {
    "beforeDevCommand": "pnpm lore:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm lore:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fallout Lore Archive",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b100d"
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../generated/fallout-lore.db": "generated/fallout-lore.db" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
